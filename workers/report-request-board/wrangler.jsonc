{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reportmode-request-board",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reportmode-request-board",
      "database_id": "148c538d-dfc1-462a-9a26-28d42595aacf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_REPORTS",
      "bucket_name": "reportmode-private-reports"
    }
  ]
}
